{
  "name": "react-zpgraph",
  "version": "1.0.0",
  "description": "React bindings for zpgraph — fast typed timeseries charts",
  "keywords": [
    "react",
    "zpgraph",
    "chart",
    "timeseries",
    "canvas",
    "visualization"
  ],
  "license": "MIT",
  "author": "João Vitor Zeppe <zeppejoaovitor@gmail.com>",
  "homepage": "https://github.com/joaovitorzeppe/react-zpgraph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaovitorzeppe/react-zpgraph.git"
  },
  "bugs": {
    "url": "https://github.com/joaovitorzeppe/react-zpgraph/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./extras": {
      "types": "./dist/extras.d.ts",
      "import": "./dist/extras.js",
      "default": "./dist/extras.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check:pkg": "publint && attw --pack . --profile esm-only",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite --config demos/vite.config.ts",
    "demo:build": "vite build --config demos/vite.config.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run check:pkg"
  },
  "dependencies": {
    "zpgraph": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "publint": "^0.3.24",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
